{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pip install --user -r requirements.txt && python3 tools/profile-viewer/build.py",
  "outputDirectory": "site",
  "functions": {
    "api/chat.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/add-entity.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/geocode.py": {
      "memory": 512,
      "maxDuration": 15
    },
    "api/spend.py": {
      "memory": 256,
      "maxDuration": 5
    }
  }
}
